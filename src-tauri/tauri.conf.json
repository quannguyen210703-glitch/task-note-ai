{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Note AI",
  "version": "2.0.0",
  "identifier": "vn.tasknoteai.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "sticky",
        "title": "Task Note AI",
        "url": "index.html?window=sticky",
        "width": 360,
        "height": 520,
        "minWidth": 320,
        "minHeight": 360,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "dashboard",
        "title": "Task Note AI — Bảng quản lý",
        "url": "index.html?window=dashboard",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "target/release/tasknote.exe": "tasknote.exe" },
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
